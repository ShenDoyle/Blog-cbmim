{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "notion:sync": "node tools/notion-sync.mjs",
    "notion:pages": "node tools/notion-pages-sync.mjs",
    "notion:selftest": "node tools/notion-selftest.mjs",
    "notion:prep": "node tools/notion-import-prep.mjs",
    "notion:link": "node tools/notion-link-existing.mjs",
    "notion:preview": "node tools/notion-sync.mjs --dry-run --verbose",
    "notion:preview-server": "node tools/notion-sync.mjs && hexo clean && hexo server",
    "publish": "node tools/notion-sync.mjs && hexo clean && hexo generate && hexo deploy"
  },
  "hexo": {
    "version": "7.0.0"
  },
  "dependencies": {
    "@notionhq/client": "^5.26.0",
    "add": "^2.0.6",
    "hexo": "^7.0.0",
    "hexo-bilibili-bangumi": "^1.8.9",
    "hexo-butterfly-envelope": "^1.0.15",
    "hexo-deployer-git": "^4.0.0",
    "hexo-douban": "^2.3.6",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-searchdb": "^1.5.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-cbmim": "github:ShenDoyle/CBMIM-theme#main",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-wordcount": "^6.0.1",
    "notion-to-md": "^3.1.9",
    "or": "^0.2.0",
    "valine": "^1.5.1",
    "yarn": "^1.22.21"
  }
}
